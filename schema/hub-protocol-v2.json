{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:a2a-hub:protocol:2",
	"title": "Hub link protocol 2",
	"description": "Generated by scripts/hub-schema.ts. Objects are open: a reader must ignore unknown fields. `x-routes` lists the link API. `x-events` lists the events of `GET /link/:agent/events`. An error body is `{ error, ...details }`. Rules for every route: each JSON response has exactly `Content-Type: application/json`. An unknown path or a wrong method gives 404 `{ \"error\": \"not found\" }`, never 405. A malformed percent escape in the path gives 400. An unexpected failure gives 500 `{ \"error\": \"internal error\" }`.",
	"$defs": {
		"AckBody": {
			"title": "AckBody",
			"type": "object",
			"required": ["upTo"],
			"properties": {
				"upTo": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"AckResult": {
			"title": "AckResult",
			"type": "object",
			"required": ["acked"],
			"properties": {
				"acked": {
					"description": "The number of events that this call acked.",
					"type": "integer"
				}
			}
		},
		"AgentInfo": {
			"title": "AgentInfo",
			"type": "object",
			"required": [
				"id",
				"name",
				"kind",
				"host",
				"cwd",
				"role",
				"labels",
				"parent",
				"topics",
				"online",
				"state",
				"activity",
				"status",
				"lastSeenAt"
			],
			"properties": {
				"id": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"kind": {
					"$ref": "#/$defs/AgentKind"
				},
				"host": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"cwd": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"role": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"labels": {
					"type": "object",
					"patternProperties": {
						"^.*$": {
							"type": "string"
						}
					}
				},
				"parent": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"topics": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"online": {
					"type": "boolean"
				},
				"state": {
					"$ref": "#/$defs/AgentState"
				},
				"activity": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"status": {
					"type": "object",
					"required": ["text", "at"],
					"properties": {
						"text": {
							"type": "string"
						},
						"at": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				"lastSeenAt": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"AgentKind": {
			"title": "AgentKind",
			"enum": ["pi", "external", "builtin"]
		},
		"AgentState": {
			"title": "AgentState",
			"enum": ["busy", "idle"]
		},
		"AgentsResult": {
			"title": "AgentsResult",
			"type": "object",
			"required": ["agents"],
			"properties": {
				"agents": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/AgentInfo"
					}
				}
			}
		},
		"BusKind": {
			"title": "BusKind",
			"enum": ["note", "question", "answer", "task", "result", "correction", "status", "event"]
		},
		"BusMetadata": {
			"title": "BusMetadata",
			"description": "Shape of `Message.metadata[BUS_EXTENSION_URI]`. Every field is optional. The hub sets `delivery` on a send result and `statusText` on a status message.",
			"type": "object",
			"properties": {
				"kind": {
					"$ref": "#/$defs/BusKind"
				},
				"wake": {
					"$ref": "#/$defs/Wake"
				},
				"subject": {
					"type": "string"
				},
				"priority": {
					"$ref": "#/$defs/Priority"
				},
				"expectReply": {
					"type": "boolean"
				},
				"deliveryWait": {
					"type": "boolean"
				},
				"replyTo": {
					"type": "string"
				},
				"data": {},
				"delivery": {
					"$ref": "#/$defs/DeliveryState"
				},
				"statusText": {
					"type": "boolean"
				}
			}
		},
		"CancelEvent": {
			"title": "CancelEvent",
			"type": "object",
			"required": ["taskId"],
			"properties": {
				"taskId": {
					"type": "string"
				}
			}
		},
		"ChildBody": {
			"title": "ChildBody",
			"type": "object",
			"required": ["id"],
			"properties": {
				"id": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"role": {
					"type": "string"
				},
				"labels": {
					"type": "object",
					"patternProperties": {
						"^.*$": {
							"type": "string"
						}
					}
				},
				"cwd": {
					"type": "string"
				}
			}
		},
		"ControlBody": {
			"title": "ControlBody",
			"type": "object",
			"required": ["target", "action"],
			"properties": {
				"target": {
					"type": "string"
				},
				"action": {
					"type": "string",
					"const": "close"
				}
			}
		},
		"ControlEvent": {
			"title": "ControlEvent",
			"type": "object",
			"required": ["action", "from"],
			"properties": {
				"action": {
					"type": "string",
					"const": "close"
				},
				"from": {
					"type": "object",
					"required": ["agent", "name"],
					"properties": {
						"agent": {
							"type": "string"
						},
						"name": {
							"type": "string"
						}
					}
				}
			}
		},
		"DeliveryState": {
			"title": "DeliveryState",
			"enum": ["delivered", "queued", "unconfirmed"]
		},
		"ErrorBody": {
			"title": "ErrorBody",
			"type": "object",
			"required": ["error"],
			"properties": {
				"error": {
					"type": "string"
				}
			}
		},
		"Health": {
			"title": "Health",
			"type": "object",
			"required": ["ok", "version", "agents"],
			"properties": {
				"ok": {
					"type": "boolean",
					"const": true
				},
				"version": {
					"type": "string"
				},
				"agents": {
					"type": "integer"
				}
			}
		},
		"InboxItem": {
			"title": "InboxItem",
			"type": "object",
			"required": [
				"messageId",
				"taskId",
				"contextId",
				"direction",
				"from",
				"to",
				"kind",
				"wake",
				"subject",
				"priority",
				"expectReply",
				"replyTo",
				"text",
				"createdAt",
				"read"
			],
			"properties": {
				"messageId": {
					"type": "string"
				},
				"taskId": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"contextId": {
					"type": "string"
				},
				"direction": {
					"enum": ["in", "out"]
				},
				"from": {
					"$ref": "#/$defs/Sender"
				},
				"to": {
					"type": "object",
					"required": ["agent", "name"],
					"properties": {
						"agent": {
							"type": "string"
						},
						"name": {
							"type": "string"
						}
					}
				},
				"kind": {
					"$ref": "#/$defs/BusKind"
				},
				"wake": {
					"$ref": "#/$defs/Wake"
				},
				"subject": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"priority": {
					"anyOf": [
						{
							"$ref": "#/$defs/Priority"
						},
						{
							"type": "null"
						}
					]
				},
				"expectReply": {
					"type": "boolean"
				},
				"replyTo": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"data": {},
				"taskState": {
					"$ref": "#/$defs/LinkTaskState",
					"description": "The current state of the linked task. Absent when there is no task or it was removed."
				},
				"text": {
					"type": "string"
				},
				"createdAt": {
					"type": "string"
				},
				"read": {
					"type": "boolean"
				}
			}
		},
		"InboxResult": {
			"title": "InboxResult",
			"type": "object",
			"required": ["messages"],
			"properties": {
				"messages": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/InboxItem"
					}
				}
			}
		},
		"LinkPostState": {
			"title": "LinkPostState",
			"enum": ["working", "input-required", "completed", "failed", "rejected"]
		},
		"LinkTaskState": {
			"title": "LinkTaskState",
			"enum": ["submitted", "working", "input-required", "completed", "failed", "canceled", "rejected", "auth-required"]
		},
		"MessageCandidatesErrorBody": {
			"title": "MessageCandidatesErrorBody",
			"type": "object",
			"required": ["error", "candidates"],
			"properties": {
				"error": {
					"type": "string"
				},
				"candidates": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["messageId", "contextId", "to", "from", "createdAt"],
						"properties": {
							"messageId": {
								"type": "string"
							},
							"contextId": {
								"type": "string"
							},
							"to": {
								"type": "string"
							},
							"from": {
								"description": "The sender agent id, else the sender name.",
								"type": "string"
							},
							"createdAt": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"MessageEvent": {
			"title": "MessageEvent",
			"type": "object",
			"required": ["messageId", "contextId", "from", "kind", "wake", "text"],
			"properties": {
				"messageId": {
					"type": "string"
				},
				"taskId": {
					"type": "string"
				},
				"contextId": {
					"type": "string"
				},
				"from": {
					"$ref": "#/$defs/Sender"
				},
				"kind": {
					"$ref": "#/$defs/BusKind"
				},
				"wake": {
					"$ref": "#/$defs/Wake"
				},
				"subject": {
					"type": "string"
				},
				"priority": {
					"$ref": "#/$defs/Priority"
				},
				"expectReply": {
					"type": "boolean"
				},
				"replyTo": {
					"type": "string"
				},
				"text": {
					"type": "string"
				},
				"data": {},
				"taskState": {
					"$ref": "#/$defs/LinkTaskState"
				}
			}
		},
		"OkResult": {
			"title": "OkResult",
			"type": "object",
			"required": ["ok"],
			"properties": {
				"ok": {
					"type": "boolean",
					"const": true
				}
			}
		},
		"PendingResult": {
			"title": "PendingResult",
			"description": "`agent` and `name` name the other side: the recipient in `pending`, the sender in `owed`.",
			"type": "object",
			"required": ["expectReply", "tasks"],
			"properties": {
				"expectReply": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["messageId", "contextId", "taskId", "agent", "name", "createdAt"],
						"properties": {
							"messageId": {
								"type": "string"
							},
							"contextId": {
								"type": "string"
							},
							"taskId": {
								"anyOf": [
									{
										"type": "string"
									},
									{
										"type": "null"
									}
								]
							},
							"agent": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"createdAt": {
								"type": "string"
							}
						}
					}
				},
				"tasks": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["taskId", "contextId", "agent", "name", "state", "createdAt"],
						"properties": {
							"taskId": {
								"type": "string"
							},
							"contextId": {
								"type": "string"
							},
							"agent": {
								"anyOf": [
									{
										"type": "string"
									},
									{
										"type": "null"
									}
								]
							},
							"name": {
								"type": "string"
							},
							"state": {
								"$ref": "#/$defs/LinkTaskState"
							},
							"createdAt": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"PresenceEvent": {
			"title": "PresenceEvent",
			"type": "object",
			"required": ["agent", "name", "online", "relation"],
			"properties": {
				"agent": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"online": {
					"type": "boolean"
				},
				"relation": {
					"description": "`peer`: the agents share an open expect_reply row or a non-terminal task.",
					"enum": ["child", "parent", "peer"]
				}
			}
		},
		"PrincipalKind": {
			"title": "PrincipalKind",
			"enum": ["host", "peer"]
		},
		"Priority": {
			"title": "Priority",
			"enum": ["normal", "important", "urgent"]
		},
		"ReadBody": {
			"title": "ReadBody",
			"type": "object",
			"required": ["ids"],
			"properties": {
				"ids": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"ReadResult": {
			"title": "ReadResult",
			"type": "object",
			"required": ["read"],
			"properties": {
				"read": {
					"description": "The number of messages that this call marked read.",
					"type": "integer"
				}
			}
		},
		"RegisterBody": {
			"title": "RegisterBody",
			"type": "object",
			"required": ["agent", "protocol"],
			"properties": {
				"agent": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"cwd": {
					"type": "string"
				},
				"role": {
					"type": "string"
				},
				"labels": {
					"type": "object",
					"patternProperties": {
						"^.*$": {
							"type": "string"
						}
					}
				},
				"parent": {
					"type": "string"
				},
				"topics": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"ephemeral": {
					"type": "boolean"
				},
				"protocol": {
					"type": "integer"
				}
			}
		},
		"RegisterResult": {
			"title": "RegisterResult",
			"type": "object",
			"required": ["agent", "name", "host"],
			"properties": {
				"agent": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"host": {
					"type": "string"
				}
			}
		},
		"ReplacedEvent": {
			"title": "ReplacedEvent",
			"type": "object",
			"properties": {}
		},
		"Sender": {
			"title": "Sender",
			"type": "object",
			"required": ["name", "kind"],
			"properties": {
				"agent": {
					"type": "string"
				},
				"name": {
					"type": "string"
				},
				"kind": {
					"anyOf": [
						{
							"$ref": "#/$defs/AgentKind"
						},
						{
							"$ref": "#/$defs/PrincipalKind"
						}
					]
				}
			}
		},
		"StateBody": {
			"title": "StateBody",
			"type": "object",
			"required": ["state"],
			"properties": {
				"state": {
					"$ref": "#/$defs/AgentState"
				},
				"activity": {
					"type": "string"
				}
			}
		},
		"StatusBody": {
			"title": "StatusBody",
			"type": "object",
			"required": ["text"],
			"properties": {
				"text": {
					"type": "string"
				}
			}
		},
		"StatusResult": {
			"title": "StatusResult",
			"type": "object",
			"required": ["text"],
			"properties": {
				"text": {
					"description": "The stored text: one line, trimmed, cut to the status length limit.",
					"type": "string"
				}
			}
		},
		"TaskUpdateBody": {
			"title": "TaskUpdateBody",
			"type": "object",
			"required": ["state"],
			"properties": {
				"state": {
					"$ref": "#/$defs/LinkPostState"
				},
				"text": {
					"type": "string"
				},
				"artifact": {
					"type": "object",
					"properties": {
						"name": {
							"type": "string"
						},
						"text": {
							"type": "string"
						},
						"data": {}
					}
				}
			}
		},
		"ThreadCandidatesErrorBody": {
			"title": "ThreadCandidatesErrorBody",
			"type": "object",
			"required": ["error", "candidates"],
			"properties": {
				"error": {
					"type": "string"
				},
				"candidates": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["contextId", "messages", "lastAt"],
						"properties": {
							"contextId": {
								"type": "string"
							},
							"messages": {
								"type": "integer"
							},
							"lastAt": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"ThreadResult": {
			"title": "ThreadResult",
			"type": "object",
			"required": ["contextId", "messages"],
			"properties": {
				"contextId": {
					"type": "string"
				},
				"messages": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/InboxItem"
					}
				}
			}
		},
		"TopicsBody": {
			"title": "TopicsBody",
			"type": "object",
			"properties": {
				"subscribe": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"unsubscribe": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"TopicsResult": {
			"title": "TopicsResult",
			"type": "object",
			"required": ["topics"],
			"properties": {
				"topics": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		},
		"UpdateEvent": {
			"title": "UpdateEvent",
			"type": "object",
			"required": ["taskId", "contextId", "state", "from"],
			"properties": {
				"taskId": {
					"type": "string"
				},
				"contextId": {
					"type": "string"
				},
				"state": {
					"$ref": "#/$defs/LinkTaskState"
				},
				"messageId": {
					"description": "Set when the update carried text. It is the id of the inbox row made for the sender.",
					"type": "string"
				},
				"kind": {
					"$ref": "#/$defs/BusKind"
				},
				"text": {
					"type": "string"
				},
				"artifacts": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"name": {
								"type": "string"
							},
							"text": {
								"type": "string"
							}
						}
					}
				},
				"from": {
					"type": "object",
					"required": ["agent", "name"],
					"properties": {
						"agent": {
							"type": "string"
						},
						"name": {
							"type": "string"
						}
					}
				}
			}
		},
		"UpdatedTaskResult": {
			"title": "UpdatedTaskResult",
			"description": "An A2A 1.0 Task in ProtoJSON. Only the fields that are always present are listed. The A2A spec owns the rest.",
			"type": "object",
			"required": ["id", "contextId", "status"],
			"properties": {
				"id": {
					"type": "string"
				},
				"contextId": {
					"type": "string"
				},
				"status": {
					"type": "object",
					"required": ["state", "timestamp"],
					"properties": {
						"state": {
							"enum": [
								"TASK_STATE_SUBMITTED",
								"TASK_STATE_WORKING",
								"TASK_STATE_COMPLETED",
								"TASK_STATE_FAILED",
								"TASK_STATE_CANCELED",
								"TASK_STATE_INPUT_REQUIRED",
								"TASK_STATE_REJECTED",
								"TASK_STATE_AUTH_REQUIRED"
							]
						},
						"timestamp": {
							"type": "string"
						}
					},
					"additionalProperties": true
				}
			},
			"additionalProperties": true
		},
		"UpgradeErrorBody": {
			"title": "UpgradeErrorBody",
			"type": "object",
			"required": ["error", "expected"],
			"properties": {
				"error": {
					"type": "string"
				},
				"expected": {
					"description": "The protocol that the hub speaks.",
					"type": "integer"
				}
			}
		},
		"Wake": {
			"title": "Wake",
			"enum": ["now", "never"]
		}
	},
