{
	"name": "pimon",
	"version": "0.4.0",
	"private": true,
	"description": "One pi extension suite: background jobs, bus, agents, goals, notifications, status line, editor, and more.",
	"type": "module",
	"license": "UNLICENSED",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git@github.com:orswn/pimon.git"
	},
	"engines": {
		"node": ">=24"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "vp check",
		"typecheck": "tsc --noEmit",
		"test": "vp test run --project unit --project integration --project process",
		"test:unit": "vp test run --project unit",
		"test:e2e": "vp test run --project e2e",
		"test:watch": "vp test --project unit",
		"verify": "npm run check && npm run typecheck && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "24.19.2",
		"typebox": "1.3.27",
		"typescript": "7.0.2",
		"vite-plus": "1.5.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
		"vitest": "5.1.0"
	}
}
