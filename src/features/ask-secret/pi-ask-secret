#!/usr/bin/env node
// Askpass client: prints the secret on stdout (exit 0) or nothing (exit 1).
// Ignores argv[2] (the caller's prompt); the reason comes from PI_ASK_SECRET_REASON.
import { connect } from "node:net";

const sock = process.env.PI_ASK_SECRET_SOCK;
if (!sock) {
	process.stderr.write("pi-ask-secret: not running under a pi TUI session\n");
	process.exit(1);
}

const reason = (process.env.PI_ASK_SECRET_REASON ?? "").replace(/[\r\n]+/g, " ").trim().slice(0, 500);

let reply = "";
// Never end our write side: the server closes half-open sockets before it can reply.
const conn = connect(sock);
conn.setEncoding("utf8");
conn.on("connect", () => conn.write(`${reason}\n`));
conn.on("data", (chunk) => (reply += chunk));
conn.on("error", (err) => {
	process.stderr.write(`pi-ask-secret: ${err.message}\n`);
	process.exit(1);
});
conn.on("close", () => {
	if (!reply) {
		process.stderr.write(
			"No secret was given. The human cancelled or did not answer. Do not retry unless the human asks again.\n",
		);
		process.exit(1);
	}
	process.stdout.write(`${reply}\n`);
});
